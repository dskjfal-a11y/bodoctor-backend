# =============================================================
# 보닥터 백엔드 환경변수 예제
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
# .env 는 .gitignore 에 포함되어 있어 깃에 올라가지 않습니다.
# 모든 키는 새로 발급한 키 사용. 채팅·코드에 노출된 키는 즉시 폐기.
# =============================================================

# ==== Google Gemini ====
GEMINI_API_KEY=PUT_NEW_KEY_HERE
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest

# ==== Pinecone (RAG 미사용 시 비워둬도 서비스는 동작) ====
PINECONE_API_KEY=
PINECONE_INDEX=
# 인덱스 생성 후 콘솔에 표시되는 호스트 (https:// 포함)
PINECONE_HOST=
# gemini-embedding-001 출력 차원 (기본 3072)
EMBED_DIM=3072

# ==== 코드에프 (CODEF) ====
# 개발: https://development.codef.io  /  운영: https://api.codef.io
# OAuth 도메인은 개발·운영 동일: https://oauth.codef.io
CODEF_CLIENT_ID=PUT_NEW_CLIENT_ID
CODEF_CLIENT_SECRET=PUT_NEW_CLIENT_SECRET
# 코드에프 콘솔에서 발급한 RSA 공개키 (PEM 본문, 줄바꿈 없이 한 줄로)
CODEF_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEF...DAQAB
CODEF_HOST=https://development.codef.io
CODEF_OAUTH_HOST=https://oauth.codef.io

# ==== 서버 ====
PORT=8787

# CORS — 정확 매칭 origin (콤마 구분)
# 로컬 개발 + 운영 도메인을 모두 포함
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://bodoctor.com,https://www.bodoctor.com

# CORS — 정규식 origin (Vercel 프리뷰 도메인처럼 동적 URL 대응)
# 예) Vercel 프리뷰: bodoctor-abc123.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/bodoctor-[a-z0-9-]+\.vercel\.app$

# ==== 구글시트 저장 (Apps Script 웹훅) ====
# 회원/상담 신청 데이터를 구글시트에 자동 저장.
# 설정법: 보험AI백엔드/GOOGLE_SHEETS_SETUP.md 참고.
# 비워두면 시트 저장은 건너뛰고 서비스는 정상 동작.
GOOGLE_SHEETS_WEBHOOK_URL=
# Apps Script 의 SECRET 과 똑같은 임의 문자열 (위변조 방지)
SHEETS_WEBHOOK_SECRET=

# ==== 카카오 로그인 (키 발급 후 입력) — KAKAO_SETUP.md 참고 ====
# REST API 키 (백엔드 토큰 교환용)
KAKAO_REST_API_KEY=
# 카카오 developers 에 등록한 Redirect URI (프론트 콜백 주소와 일치)
KAKAO_REDIRECT_URI=
# 보안 강화(보안 → Client Secret 사용 ON 한 경우만)
KAKAO_CLIENT_SECRET=

# ==== DB (옵션) — connectedId 영구 저장용. 없으면 메모리 저장 ====
# SQLite 파일 경로 또는 PostgreSQL 연결 문자열
# DATABASE_URL=sqlite:./data/codef.sqlite
